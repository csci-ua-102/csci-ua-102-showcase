rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public: what the site displays to everyone. No names, no NetIDs.
    match /submissions/{teamId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['team', 'desc', 'link']) &&
        request.resource.data.team is string &&
        request.resource.data.team.size() > 0 && request.resource.data.team.size() < 120 &&
        request.resource.data.desc is string && request.resource.data.desc.size() < 500 &&
        request.resource.data.link is string && request.resource.data.link.size() < 500 &&
        (!('thumbnail' in request.resource.data) ||
          (request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() < 500));
      // Immutable once created — nobody (including the original team) can
      // edit or delete a submission from the client. This is what prevents
      // one team from tampering with another team's entry, without needing
      // logins or secret edit codes. Corrections go through the TA via the
      // Firebase console.
      allow update: if false;
      allow delete: if false;
    }

    // Private: names + NetIDs, for grading only. Never readable by any
    // client — not the public page, not even the team that submitted it.
    // Only visible via the Firebase console (which requires your login).
    match /rosters/{teamId} {
      allow read: if false;
      allow create: if
        request.resource.data.keys().hasAll(['members']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() > 0 &&
        request.resource.data.members.size() <= 6;
      allow update: if false;
      allow delete: if false;
    }
  }
}
